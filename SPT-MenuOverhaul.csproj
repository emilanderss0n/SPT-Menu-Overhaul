    <EmbeddedResource Remove="build\**" />
    <None Remove="build\**" />
    <None Include=".github\copilot-instructions.md" />
    <None Include="build\postbuild-copy.cmd" />
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

